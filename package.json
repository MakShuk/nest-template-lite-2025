{
  "name": "nest-template-lite",
  "version": "2.0.0",
  "description": "A reusable NestJS starter with typed configuration, structured logging, CLI, OpenAPI, and Docker.",
  "author": "Maksim Shuklin",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MakShuk/nest-template-lite-2025.git"
  },
  "homepage": "https://github.com/MakShuk/nest-template-lite-2025#readme",
  "bugs": {
    "url": "https://github.com/MakShuk/nest-template-lite-2025/issues"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "cli": "node dist/cli.js",
    "cli:dev": "ts-node src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run check && npm run typecheck && npm test && npm run audit:prod"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "joi": "^18.2.3",
    "nest-commander": "^3.20.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.46",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
