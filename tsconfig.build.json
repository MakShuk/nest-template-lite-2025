{
  "extends": "./tsconfig.json",
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "**/*.spec.ts", "**/*.test.ts", "**/*.mock.ts"],
  "compilerOptions": {
    "sourceMap": false,
    "removeComments": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmitOnError": true
  }
}
